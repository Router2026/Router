# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=israel_nature
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── ETL Behaviour ────────────────────────────────────────────────────────────
# Set to 'true' to print each SQL query (verbose mode)
LOG_QUERIES=false

# ─── Optional: Overpass API mirror (if the main server is slow) ───────────────
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter

# ─── Optional: Proxy (if behind a corporate firewall) ─────────────────────────
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
