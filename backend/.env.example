# ─────────────────────────────────────────────────────────────────────────────
# Router — backend environment variables
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ROTATE every 90 days: generate a new value, update here and in Vercel, then redeploy.
JWT_SECRET=CHANGE_ME_generate_with_node_crypto_randomBytes_64

# ── CORS (REQUIRED in production) ────────────────────────────────────────────
# Set to your exact frontend URL — no trailing slash.
# Without this, CORS will fall back to http://localhost:5173 (dev default).
# In Vercel: Project Settings → Environment Variables → FRONTEND_URL
FRONTEND_URL=https://your-app.vercel.app

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-anon-key>
SUPABASE_SERVICE_KEY=<supabase-service-role-key>

# Project Settings → Database → Transaction pooler connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Rate limiting — Upstash Redis (STRONGLY RECOMMENDED for production) ──────
# Without this, rate limits reset on every server restart / Vercel cold start.
# 1. Create a free Redis database at https://console.upstash.com
# 2. Copy the REST URL and token from the database dashboard
# ROTATE the token if you suspect it has been compromised.
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-rest-token>

# ── Email / SMTP (optional — logs to console if not set) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password   # Generate at myaccount.google.com/apppasswords
SMTP_FROM=Router <noreply@router.app>
APP_URL=http://localhost:3000

# ── AI route planner (Groq) ──────────────────────────────────────────────────
# Without GROQ_API_KEY the planner still works using the deterministic fallback.
GROQ_API_KEY=gsk_...
# Primary model: fast, high rate limits.
GROQ_MODEL=openai/gpt-oss-20b
# Used only when the primary returns 429 (strict JSON schema, low OTPM limit).
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# auto (default) | json_object | json_schema | json_schema_strict
# auto = strict json_schema on models that support it, json_object otherwise.
GROQ_RESPONSE_MODE=auto
# Must stay below the model's output-tokens-per-minute (OTPM) limit or every call 429s.
GROQ_MAX_COMPLETION_TOKENS=800
# Max AI routes per user per hour (Postgres-backed, see migration 0008)
AI_ROUTE_HOURLY_LIMIT=10

# ── Semantic search (/api/locations/search) ──────────────────────────────────
# Embeddings use OPENAI_API_KEY (text-embedding-3-small, 768 dims — fixed in code).
# Run `npm run embed:sync` after ETL imports / bulk edits.
# English→Hebrew query translation reuses GROQ_API_KEY. Optional override;
# default openai/gpt-oss-120b (measured best by `npm run search:eval`).
# GROQ_TRANSLATE_MODEL=openai/gpt-oss-120b

# ── AI trip assistant chat (/api/assistant/chat, admin-only for now) ─────────
# Uses OPENAI_API_KEY. Compare models with: npm run assistant:eval -- --models=a,b
# Default gpt-5.4-mini (7/8 scenarios, ~2.3s); gpt-5.5 scored 8/8 at ~3.4s.
# OPENAI_ASSISTANT_MODEL=gpt-5.4-mini
# Reasoning models only accept "none" together with tools in Chat Completions.
# OPENAI_ASSISTANT_REASONING=none

# ── Trip Bucket "smart build" (lib/trip-bucket/smart-build.ts) ───────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Misc ──────────────────────────────────────────────────────────────────────
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
MAP_CACHE_TTL=300
LIST_CACHE_TTL=60
