# LLM Provider — set to "openai", "anthropic", or "ollama"
LLM_PROVIDER=openai
# Ollama (local, free) — set LLM_PROVIDER=ollama and configure:
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# LLM API Keys — only the key for the selected provider is required
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Maps API Key (server-side only — never use NEXT_PUBLIC_ prefix)
GOOGLE_MAPS_API_KEY=

# Neon PostgreSQL connection string
DATABASE_URL=

# Admin interface secret token
ADMIN_SECRET=
