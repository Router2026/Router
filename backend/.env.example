# LLM Provider — set to "openai", "anthropic", or "ollama"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# LLM API Keys — only the key for the selected provider is required
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Maps API Key (server-side only — never use NEXT_PUBLIC_ prefix)
GOOGLE_MAPS_API_KEY=

# Local Docker DB (all tables — main app + Router)
DATABASE_URL=

# Neon (kept for reference)
# NEON_DATABASE_URL=postgresql://neondb_owner:npg_cEbyN1dmLft9@ep-morning-glade-a413vfxw-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Admin interface secret token
ADMIN_SECRET=

# JWT secret for user auth (change in production!)
JWT_SECRET=router-jwt-secret-change-in-production

# Email (SMTP) — if not set, verification/reset links are logged to the backend console
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Router <noreply@router.app>
APP_URL=http://localhost:5173

# Router app settings
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
MAP_CACHE_TTL=300
LIST_CACHE_TTL=60