# ─────────────────────────────────────────────────────────────────────────────
# Router — backend environment variables
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ROTATE every 90 days: generate a new value, update here and in Vercel, then redeploy.
JWT_SECRET=CHANGE_ME_generate_with_node_crypto_randomBytes_64

# ── CORS (REQUIRED in production) ────────────────────────────────────────────
# Set to your exact frontend URL — no trailing slash.
# Without this, CORS will fall back to http://localhost:5173 (dev default).
# In Vercel: Project Settings → Environment Variables → FRONTEND_URL
FRONTEND_URL=https://your-app.vercel.app

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-anon-key>
SUPABASE_SERVICE_KEY=<supabase-service-role-key>

# Project Settings → Database → Transaction pooler connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Rate limiting — Upstash Redis (STRONGLY RECOMMENDED for production) ──────
# Without this, rate limits reset on every server restart / Vercel cold start.
# 1. Create a free Redis database at https://console.upstash.com
# 2. Copy the REST URL and token from the database dashboard
# ROTATE the token if you suspect it has been compromised.
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-rest-token>

# ── Email / SMTP (optional — logs to console if not set) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password   # Generate at myaccount.google.com/apppasswords
SMTP_FROM=Router <noreply@router.app>
APP_URL=http://localhost:3000

# ── LLM provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# ── Misc ──────────────────────────────────────────────────────────────────────
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
MAP_CACHE_TTL=300
LIST_CACHE_TTL=60
