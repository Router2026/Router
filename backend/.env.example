# LLM Provider — set to "openai", "anthropic", or "ollama"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — get from: Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-anon-key>gv

# Supabase DB — get from: Project Settings → Database → Transaction pooler connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# JWT secret for user auth (change in production!)
JWT_SECRET=router-jwt-secret-change-in-production

# Email (SMTP) — if not set, verification/reset links are logged to the backend console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Router <noreply@router.app>
APP_URL=http://localhost:3000

# Router app settings
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
MAP_CACHE_TTL=300
LIST_CACHE_TTL=60
